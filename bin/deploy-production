#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Hold the lock for the whole deploy, including git pull and all image builds.
# Never unlink it: a second process must lock the same inode after we exit.
command -v flock >/dev/null || { echo 'Deployment requires flock (util-linux) on the VPS.' >&2; exit 1; }
(umask 077; touch /tmp/soamco-production-deploy.lock)
exec 9<>/tmp/soamco-production-deploy.lock
flock -n 9 || { echo 'Another Soamco production deployment is running. Nothing was changed.' >&2; exit 1; }

# Compose limits service builds; disabling Bake keeps that limit authoritative.
export COMPOSE_PARALLEL_LIMIT=1
export COMPOSE_BAKE=false

check_resources() {
    local available_ram swap_total swap_free docker_root path free_kb free_inodes
    if [[ ! -r /proc/meminfo ]]; then
        echo 'Cannot read Linux RAM/swap availability; deployment stopped before build.' >&2
        return 1
    fi
    read -r available_ram swap_total swap_free < <(awk '
        /^MemAvailable:/ { ram = $2 }
        /^SwapTotal:/ { total = $2 }
        /^SwapFree:/ { free = $2 }
        END { printf "%d %d %d\n", ram, total, free }
    ' /proc/meminfo)
    printf 'Preflight: available RAM=%s MiB, swap total=%s MiB, swap free=%s MiB\n' \
        "$((available_ram / 1024))" "$((swap_total / 1024))" "$((swap_free / 1024))"
    # Leave headroom for the live site on a 4 GiB RAM / 2 GiB swap VPS.
    if (( available_ram < 768 * 1024 || swap_total < 1536 * 1024 || swap_free < 1024 * 1024 || available_ram + swap_free < 2560 * 1024 )); then
        echo 'Insufficient build headroom: require 768 MiB available RAM, 1.5 GiB configured swap, 1 GiB free swap and 2.5 GiB available RAM + free swap. Live services were left running.' >&2
        return 1
    fi
    docker_root="$(docker info --format '{{.DockerRootDir}}')"
    if [[ -z "$docker_root" || ! -d "$docker_root" ]]; then
        echo 'Cannot inspect the local Docker data directory; deployment stopped before build.' >&2
        return 1
    fi
    for path in "$PWD" "$docker_root"; do
        free_kb="$(df -Pk "$path" | awk 'NR == 2 { print $4 }')"
        free_inodes="$(df -Pi "$path" | awk 'NR == 2 { print $4 }')"
        if [[ ! "$free_kb" =~ ^[0-9]+$ || ! "$free_inodes" =~ ^[0-9]+$ ]]; then
            echo "Cannot determine free disk space/inodes for $path; deployment stopped before build." >&2
            return 1
        fi
        printf 'Preflight: %s free=%s MiB, free inodes=%s\n' "$path" "$((free_kb / 1024))" "$free_inodes"
        if (( free_kb < 8192 * 1024 || free_inodes < 50000 )); then
            echo 'Insufficient build disk headroom: require 8 GiB and 50000 free inodes on both checkout and Docker filesystems. No images or volumes were removed.' >&2
            return 1
        fi
    done
}

if [[ "${1:-}" != '--skip-pull' ]]; then
    git diff --quiet && git diff --cached --quiet || { echo 'Commit or stash tracked changes before deployment.' >&2; exit 1; }
    git pull --ff-only
fi
release="$(git rev-parse --short=12 HEAD)-$(date -u +%Y%m%d%H%M%S)"
export SOAMCO_PHP_IMAGE="${SOAMCO_PHP_IMAGE:-soamco-budget-php:$release}"
export SOAMCO_WEB_IMAGE="${SOAMCO_WEB_IMAGE:-soamco-budget-web:$release}"
env_file="${SOAMCO_ENV_FILE:-.env}"
env_args=(--env-file "$env_file")
if [[ -n "${SOAMCO_COMPOSE_ENV_FILE:-}" ]]; then
    env_args+=(--env-file "$SOAMCO_COMPOSE_ENV_FILE")
fi
compose() { docker compose --parallel 1 "${env_args[@]}" -f docker-compose.yml -f docker-compose.production.yml "$@"; }
maintenance=false
proxy_maintenance=false
scratch="$(mktemp -d)"
restore_proxy() {
    compose exec -T proxy caddy reload --config /config/soamco-deploy-normal.json
    proxy_maintenance=false
    compose exec -T proxy rm -f /config/soamco-deploy-normal.json
}
cleanup() {
    status=$?
    trap - EXIT
    if $maintenance; then
        # Never reopen the proxy onto unavailable app/web after a failed recreate.
        if compose exec -T app application-healthcheck && compose exec -T web wget -q -O /dev/null http://127.0.0.1/up && compose exec -T app php artisan up; then
            if $proxy_maintenance; then restore_proxy || true; fi
            compose start horizon scheduler reverb || true
        fi
    elif $proxy_maintenance; then
        restore_proxy || true
    fi
    rm -rf "$scratch"
    if (( status != 0 )); then
        echo 'Deploy failed. Healthy services may be reopened; otherwise the Soamco maintenance route is preserved. Inspect service health. Previous images and all volumes were preserved.' >&2
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

compose config --quiet
check_resources
for service in app web; do
    previous="$(compose ps --status running -q "$service")"
    if [[ -n "$previous" ]]; then
        printf 'Previous %s image ID: ' "$service"
        docker inspect --format '{{.Image}}' "$previous"
    fi
done
compose build app web
compose run --rm --no-deps --entrypoint sh app -c 'test -f artisan && test -f vendor/autoload.php && test -s public/build/manifest.json'
# Initialize permissions only after every image (including frontend) has built successfully.
compose run --rm --no-deps logs-init
# Inspect the existing private volume as the runtime user before any downtime.
# Never import host credentials, overwrite files or print credential contents.
compose run --rm --no-deps --user www-data --entrypoint php app docker/php/firebase-credentials-check.php
# Prepare the unchanged Soamco view and the proxy switch before entering maintenance.
if compose exec -T proxy test -s /config/soamco-deploy-normal.json; then
    # A failed deploy may still be serving this container: do not recreate it.
    compose start maintenance
    compose exec -T maintenance php -r "exit(@file_get_contents('http://127.0.0.1:8000/__maintenance_health') === 'ready' ? 0 : 1);"
    compose cp proxy:/config/soamco-deploy-normal.json "$scratch/normal.json"
else
    compose up -d --no-deps --no-build --wait --wait-timeout 60 maintenance
    compose exec -T proxy wget -q -O - http://127.0.0.1:2019/config/ > "$scratch/normal.json"
fi
compose run -T --rm --no-deps --entrypoint php app docker/caddy/maintenance-config.php < "$scratch/normal.json" > "$scratch/maintenance.json"
compose cp "$scratch/normal.json" proxy:/config/soamco-deploy-normal.json
compose cp "$scratch/maintenance.json" proxy:/config/soamco-deploy-maintenance.json
# Reload is atomic: no proxy restart and no app/web downtime has started yet.
compose exec -T proxy caddy reload --config /config/soamco-deploy-maintenance.json
proxy_maintenance=true
maintenance=true
if [[ -n "$(compose ps --status running -q app)" ]]; then
    compose exec -T app php artisan down --retry=60
fi
# Shared Redis maintenance survives container recreation, unlike the old file driver.
compose run --rm --no-deps app php artisan down --retry=60
compose stop horizon scheduler reverb
compose run --rm --no-deps app php artisan migrate --force --no-interaction
compose up -d --no-deps --no-build --force-recreate --wait --wait-timeout 180 app web
compose up -d --no-deps --no-build --force-recreate --wait --wait-timeout 180 horizon scheduler reverb
compose exec -T app php artisan up
maintenance=false
restore_proxy
compose stop maintenance
compose ps
printf 'Deployed PHP=%s WEB=%s\n' "$SOAMCO_PHP_IMAGE" "$SOAMCO_WEB_IMAGE"
