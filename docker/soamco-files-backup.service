[Unit]
Description=Soamco Budget encrypted persistent files hot backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/soamco-backup-files --config /etc/soamco-backup/files.json
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal
SyslogIdentifier=soamco-files-backup
