{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "prepare": "node .husky/install.mjs",
        "test:hooks": "node --test tests/frontend-pre-commit.test.mjs tests/frontend-pre-push.test.mjs",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "vue-tsc --noEmit"
    },
    "lint-staged": {
        "**/*.{vue,js,cjs,mjs,ts,cts,mts,jsx,tsx}": [
            "eslint --fix --no-warn-ignored",
            "prettier --write",
            "eslint --no-warn-ignored"
        ],
        "resources/**/*.{json,jsonc,css,scss,less,md,mdx,html,yml,yaml,graphql,gql}": "prettier --write"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^10.11.1",
        "husky": "9.1.7",
        "lint-staged": "16.4.0",
        "prettier": "3.8.3",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "shadcn-vue": "^2.4.3",
        "typescript": "5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^7.3.2",
        "vue-tsc": "^2.2.4"
    },
    "dependencies": {
        "@inertiajs/vue3": "^2.3.7",
        "@popperjs/core": "^2.11.8",
        "@tinymce/tinymce-vue": "6.3.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "echarts": "^6.0.0",
        "firebase": "^12.19.0",
        "laravel-echo": "^2.2.6",
        "laravel-vite-plugin": "^2.0.0",
        "lucide-vue-next": "^0.468.0",
        "notivue": "^2.4.5",
        "pusher-js": "^8.4.0-rc2",
        "reka-ui": "^2.6.1",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tinymce": "^8.10.0",
        "tw-animate-css": "^1.2.5",
        "v-calendar": "^3.1.2",
        "vue": "^3.5.13",
        "vue-i18n": "^11.3.0",
        "vue-input-otp": "^0.3.2"
    },
    "optionalDependencies": {
        "@rollup/rollup-darwin-arm64": "4.60.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-darwin-arm64": "^4.0.1",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-darwin-arm64": "^1.29.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "overrides": {
        "@firebase/firestore": {
            "@grpc/grpc-js": "^1.13.6"
        },
        "stylus": "0.64.0"
    }
}
